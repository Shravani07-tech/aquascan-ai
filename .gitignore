# Environment
.venv/
__pycache__/
*.pyc

# Datasets (large; tracked outside git)
dataset_clean/
dataset_raw/
dataset_webcam/

# Training runs / outputs / large artifacts
runs/
outputs/
*.zip
*.pt
# ...except the deployed model, so a fresh Raspberry Pi gets it with `git clone` (6.2 MB)
!models/best.pt

# Rolling webcam debug snapshot (overwritten every frame; may contain people)
scratch/webcam_debug.jpg

# Frame-collector output (if enabled)
debug_frames/

# Local-only evidence frames that contain people (never commit)
scratch/private/

# Pi runtime files (created on the Pi, never committed)
edge.env
edge_output/
