# Copy to /home/shanki/aquascan/edge.env on the Pi and edit. Read by aquascan-edge.service.
# Laptop backend URL: use the laptop's current LAN IP (DHCP on the hotspot - re-check with ipconfig).
AQUASCAN_SERVER=http://172.24.21.133:8000
# Max frames/s sent to the dashboard (inference itself runs at full speed)
AQUASCAN_SEND_FPS=5
# JPEG quality of the frames sent
AQUASCAN_SEND_QUALITY=70
