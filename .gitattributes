# The Raspberry Pi (Linux) must get Unix line endings for scripts, services and Python,
# whatever core.autocrlf is set to on the Windows laptop.
*.sh            text eol=lf
*.service       text eol=lf
*.env.example   text eol=lf
*.py            text eol=lf
# Binary files: never convert
*.pt            binary
*.jpg           binary
*.png           binary
*.docx          binary
*.ipynb         text
